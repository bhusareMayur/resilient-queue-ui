{
  "name": "@mayurbhusare/resilient-queue-ui",
  "version": "0.1.0",
  "description": "Standalone administration dashboard and API adapter for @mayurbhusare/resilient-queue",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./api-client": "./src/ui/api-client.js",
    "./ui/*": "./src/ui/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs",
  "license": "MIT",
  "author": "Mayur S. Bhusare",
  "keywords": [
    "redis",
    "queue",
    "dashboard",
    "admin",
    "ui",
    "monitoring",
    "resilient-queue",
    "job-queue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/resilient-queue/resilient-queue-ui.git"
  },
  "bugs": {
    "url": "https://github.com/resilient-queue/resilient-queue-ui/issues"
  },
  "homepage": "https://github.com/resilient-queue/resilient-queue-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "node examples/dev-server.js",
    "test": "node --test",
    "test:frontend": "node --test tests/unit/api-client.test.js tests/unit/ui-components.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:browser": "node --test tests/e2e/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js"
  },
  "peerDependencies": {
    "@mayurbhusare/resilient-queue": "^2.0.0"
  },
  "devDependencies": {
    "@mayurbhusare/resilient-queue": "^2.0.0"
  }
}
